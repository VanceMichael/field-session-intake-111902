{
  "label": "研学现场资料与学校领件口",
  "routes": [
    {
      "method": "GET",
      "path": "/device/manifest",
      "note": "每包的 interval 是此开机段的闭区间记录序号。pending 表示仪器尚未交包，available 仍需获取原文。",
      "steps": [
        [
          {
            "device": "I4",
            "boot": "B12",
            "packet": "E-18",
            "interval": [
              7,
              8
            ],
            "state": "available"
          },
          {
            "device": "I4",
            "boot": "B12",
            "packet": "E-19",
            "interval": [
              9,
              9
            ],
            "state": "pending"
          },
          {
            "device": "I4",
            "boot": "B13",
            "packet": "E-21",
            "interval": [
              7,
              7
            ],
            "state": "available"
          }
        ],
        [
          {
            "device": "I4",
            "boot": "B12",
            "packet": "E-18",
            "interval": [
              7,
              8
            ],
            "state": "available"
          },
          {
            "device": "I4",
            "boot": "B12",
            "packet": "E-19",
            "interval": [
              8,
              9
            ],
            "state": "available",
            "location": "领队回库"
          },
          {
            "device": "I4",
            "boot": "B13",
            "packet": "E-21",
            "interval": [
              7,
              7
            ],
            "state": "available"
          }
        ]
      ],
      "status": 200,
      "kind": "json"
    },
    {
      "method": "GET",
      "path": "/device/exports",
      "note": "每行一条 JSON。tickMs 为开机后的毫秒。device、boot、sampleNo、channel 共同限定读数身份。",
      "steps": [
        [
          {
            "device": "I4",
            "boot": "B12",
            "sampleNo": 7,
            "tickMs": 9000,
            "channel": "temp",
            "value": 14.2,
            "stamp": "S18"
          },
          {
            "device": "I4",
            "boot": "B12",
            "sampleNo": 8,
            "tickMs": 18000,
            "channel": "cond",
            "value": 405,
            "stamp": "S19"
          }
        ],
        [
          {
            "device": "I4",
            "boot": "B12",
            "sampleNo": 7,
            "tickMs": 9000,
            "channel": "temp",
            "value": 14.2,
            "stamp": "S18"
          },
          {
            "device": "I4",
            "boot": "B12",
            "sampleNo": 8,
            "tickMs": 18000,
            "channel": "cond",
            "value": 405,
            "stamp": "S19"
          }
        ]
      ],
      "status": 200,
      "kind": "ndjson",
      "query": {
        "packet": "E-18"
      }
    },
    {
      "method": "GET",
      "path": "/device/exports",
      "note": "领队离线包和仪器原包的记录号可能重叠。",
      "steps": [
        [],
        [
          {
            "device": "I4",
            "boot": "B12",
            "sampleNo": 8,
            "tickMs": 18000,
            "channel": "cond",
            "value": 405,
            "stamp": "S19"
          },
          {
            "device": "I4",
            "boot": "B12",
            "sampleNo": 9,
            "tickMs": 26000,
            "channel": "temp",
            "value": 14.4,
            "stamp": "S19"
          }
        ]
      ],
      "status": 200,
      "kind": "ndjson",
      "query": {
        "packet": "E-19"
      }
    },
    {
      "method": "GET",
      "path": "/device/exports",
      "note": "另一次开机后获取的仪器包。",
      "steps": [
        [
          {
            "device": "I4",
            "boot": "B13",
            "sampleNo": 7,
            "tickMs": 5000,
            "channel": "cond",
            "value": 402,
            "stamp": "S20"
          }
        ],
        [
          {
            "device": "I4",
            "boot": "B13",
            "sampleNo": 7,
            "tickMs": 5000,
            "channel": "cond",
            "value": 402,
            "stamp": "S20"
          }
        ]
      ],
      "status": 200,
      "kind": "ndjson",
      "query": {
        "packet": "E-21"
      }
    },
    {
      "method": "POST",
      "path": "/device/receipts",
      "note": "包领取受理包含 requestKey、packet、boot、records，records 是原包中已收的记录号。",
      "steps": [
        {
          "fields": [
            "requestKey",
            "packet",
            "boot",
            "records"
          ],
          "pendingUntil": 0,
          "response": "receipt"
        },
        {
          "fields": [
            "requestKey",
            "packet",
            "boot",
            "records"
          ],
          "pendingUntil": 0,
          "response": "receipt"
        }
      ],
      "status": 200,
      "kind": "json"
    },
    {
      "method": "GET",
      "path": "/device/receipts",
      "note": "按原经办号核对包领取。",
      "steps": [
        {
          "lookup": "receipt",
          "key": "requestKey"
        },
        {
          "lookup": "receipt",
          "key": "requestKey"
        }
      ],
      "status": 200,
      "kind": "json"
    },
    {
      "method": "GET",
      "path": "/device/calibration",
      "note": "UTC 锚点含可能的最大绝对偏移秒数。channelWindow 为厂端允许的开机毫秒区间。",
      "steps": [
        [
          {
            "device": "I4",
            "boot": "B12",
            "openedAt": "2026-11-19T01:11:00Z",
            "uncertaintySeconds": 3,
            "channelWindow": {
              "temp": [
                0,
                30000
              ],
              "cond": [
                10000,
                30000
              ]
            }
          },
          {
            "device": "I4",
            "boot": "B13",
            "openedAt": "2026-11-19T01:15:00Z",
            "uncertaintySeconds": 4,
            "channelWindow": {
              "temp": [
                0,
                30000
              ]
            }
          }
        ],
        [
          {
            "device": "I4",
            "boot": "B12",
            "openedAt": "2026-11-19T01:11:00Z",
            "uncertaintySeconds": 3,
            "channelWindow": {
              "temp": [
                0,
                30000
              ],
              "cond": [
                10000,
                30000
              ]
            }
          },
          {
            "device": "I4",
            "boot": "B13",
            "openedAt": "2026-11-19T01:15:00Z",
            "uncertaintySeconds": 4,
            "channelWindow": {
              "temp": [
                0,
                30000
              ]
            }
          }
        ]
      ],
      "status": 200,
      "kind": "json"
    },
    {
      "method": "GET",
      "path": "/locker/transfers",
      "note": "交接时刻使用 UTC。更正单以 replaces 指向原登记号。",
      "steps": [
        [
          {
            "id": "H1",
            "device": "I4",
            "at": "2026-11-19T01:02:00Z",
            "source": "柜台",
            "target": "A"
          },
          {
            "id": "H2",
            "device": "I4",
            "at": "2026-11-19T01:11:22Z",
            "source": "A",
            "target": "B"
          }
        ],
        [
          {
            "id": "H1",
            "device": "I4",
            "at": "2026-11-19T01:02:00Z",
            "source": "柜台",
            "target": "A"
          },
          {
            "id": "H3",
            "replaces": "H2",
            "device": "I4",
            "at": "2026-11-19T01:11:13Z",
            "source": "A",
            "target": "B"
          }
        ]
      ],
      "status": 200,
      "kind": "json"
    },
    {
      "method": "GET",
      "path": "/station/logbook",
      "note": "stamp 是现场登记，迁移记录只在注明时段及原点位范围生效。replacementPurpose 是场地方补做的许可用途。",
      "steps": [
        [
          {
            "stamp": "S18",
            "station": "湿地西",
            "at": "2026-11-19T01:11:09Z"
          },
          {
            "stamp": "S19",
            "station": "湿地北",
            "at": "2026-11-19T01:11:18Z"
          },
          {
            "stamp": "S20",
            "station": "湿地北"
          }
        ],
        [
          {
            "stamp": "S18",
            "station": "湿地西",
            "at": "2026-11-19T01:11:09Z"
          },
          {
            "stamp": "S19",
            "station": "湿地北",
            "at": "2026-11-19T01:11:18Z",
            "witnesses": [
              "A",
              "B"
            ]
          },
          {
            "stamp": "S20",
            "station": "湿地北",
            "replacementPurpose": "课堂对照",
            "date": "2026-11-20"
          }
        ]
      ],
      "status": 200,
      "kind": "json"
    },
    {
      "method": "POST",
      "path": "/school/pickups",
      "note": "学校领件口收 requestKey、group、observations、purpose，撤回另带 priorReceipt。",
      "steps": [
        {
          "fields": [
            "requestKey",
            "group",
            "observations",
            "purpose"
          ],
          "pendingUntil": 0,
          "response": "receipt"
        },
        {
          "fields": [
            "requestKey",
            "group",
            "observations",
            "purpose"
          ],
          "pendingUntil": 0,
          "response": "receipt"
        }
      ],
      "status": 200,
      "kind": "json"
    },
    {
      "method": "GET",
      "path": "/school/pickups",
      "note": "原领取号查询。",
      "steps": [
        {
          "lookup": "receipt",
          "key": "requestKey"
        },
        {
          "lookup": "receipt",
          "key": "requestKey"
        }
      ],
      "status": 200,
      "kind": "json"
    }
  ]
}
